{% doc %}
  @prompt
    have blog posts layout 3 across with all the same width and height sizing, Use system headers for font, provide paragraph size font options under the typography, create Excerpt size as system paragraph sizing, make image height adjustable, make the excerpt and header padding adjustable, provide top and bottom padding for all typography

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-posts-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-blog-post-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-blog-post-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
  }

  .ai-blog-post-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
  }

  .ai-blog-post-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-blog-post-card-{{ ai_gen_id }}:hover .ai-blog-post-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-blog-post-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-blog-post-image-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.5;
  }

  .ai-blog-post-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .ai-blog-post-date-{{ ai_gen_id }} {
    color: {{ block.settings.date_color }};
    margin-top: {{ block.settings.date_top_padding }}px;
    margin-bottom: {{ block.settings.date_bottom_padding }}px;
    text-transform: {{ block.settings.date_text_transform }};
    font-size: {{ block.settings.date_font_size }}px;
  }

  .ai-blog-post-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    margin: {{ block.settings.title_top_padding }}px 0 {{ block.settings.title_bottom_padding }}px;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
  }

  .ai-blog-post-title-{{ ai_gen_id }}:hover {
    color: {{ block.settings.title_hover_color }};
  }

  .ai-blog-post-excerpt-{{ ai_gen_id }} {
    color: {{ block.settings.excerpt_color }};
    line-height: 1.5;
    margin-top: {{ block.settings.excerpt_top_padding }}px;
    margin-bottom: {{ block.settings.excerpt_bottom_padding }}px;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-blog-post-author-{{ ai_gen_id }} {
    color: {{ block.settings.author_color }};
    margin-top: {{ block.settings.author_top_padding }}px;
    margin-bottom: {{ block.settings.author_bottom_padding }}px;
    font-size: {{ block.settings.author_font_size }}px;
  }

  .ai-blog-posts-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.excerpt_color }};
  }

  @media screen and (max-width: 990px) {
    .ai-blog-posts-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.8 }}px;
    }

    .ai-blog-post-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.image_height_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-blog-posts-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap | times: 0.6 }}px;
    }

    .ai-blog-post-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }

    .ai-blog-post-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.image_height_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-blog-posts-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.blog != blank and block.settings.blog.articles.size > 0 %}
    {% for article in block.settings.blog.articles limit: block.settings.posts_to_show %}
      <article class="ai-blog-post-card-{{ ai_gen_id }}">
        <div class="ai-blog-post-image-wrapper-{{ ai_gen_id }}">
          {% if article.image %}
            <img
              src="{{ article.image | image_url: width: 600 }}"
              alt="{{ article.image.alt | escape }}"
              class="ai-blog-post-image-{{ ai_gen_id }}"
              loading="lazy"
              width="600"
              height="{{ block.settings.image_height }}"
            >
          {% else %}
            <div class="ai-blog-post-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-blog-post-content-{{ ai_gen_id }}">
          {% if block.settings.show_date %}
            <time class="ai-blog-post-date-{{ ai_gen_id }} {{ block.settings.date_heading_size }}" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
              {{ article.published_at | date: block.settings.date_format }}
            </time>
          {% endif %}

          <{{ block.settings.title_heading_tag }}>
            <a href="{{ article.url }}" class="ai-blog-post-title-{{ ai_gen_id }} {{ block.settings.title_heading_size }}">
              {{ article.title }}
            </a>
          </{{ block.settings.title_heading_tag }}>

          {% if block.settings.show_excerpt and article.excerpt != blank %}
            <div class="ai-blog-post-excerpt-{{ ai_gen_id }} {{ block.settings.paragraph_size }}">
              {{ article.excerpt | strip_html | truncate: 120 }}
            </div>
          {% endif %}

          {% if block.settings.show_author and article.author != blank %}
            <div class="ai-blog-post-author-{{ ai_gen_id }} {{ block.settings.author_heading_size }}">
              By {{ article.author }}
            </div>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  {% else %}
    <div class="ai-blog-posts-empty-{{ ai_gen_id }}">
      <p>No blog posts found. Please select a blog in the block settings.</p>
    </div>
  {% endif %}
</div>

