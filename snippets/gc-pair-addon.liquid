{%- comment -%}
  Gypset Cargo: "add a pair" for wall sconces. Shows on products whose type or title includes "Sconce",
  or that carry the tag "pair". Add the tag "no-pair" to hide it on a product.
  Adds two of the selected variant in one tap.
{%- endcomment -%}
{%- assign gc_text = product.type | append: ' ' | append: product.title | downcase -%}
{%- unless product.available == false or product.tags contains 'no-pair' -%}
  {%- if gc_text contains 'sconce' or product.tags contains 'pair' -%}
    {%- assign gc_variant = product.selected_or_first_available_variant -%}
    {%- if gc_variant.inventory_management == blank or gc_variant.inventory_policy == 'continue' or gc_variant.inventory_quantity >= 2 -%}
      <div class="gc-addon gc-addon--pair">
        <p><span class="gc-addon__title">Usually hung in pairs.</span> Either side of a bed, mirror or doorway.</p>
        <button type="button" class="gc-addon__button" data-gc-add data-quantity="2" data-added-text="Pair added">
          <span data-gc-label>Add a pair, {{ gc_variant.price | times: 2 | money }}</span>
        </button>
      </div>
    {%- endif -%}
  {%- endif -%}
{%- endunless -%}
