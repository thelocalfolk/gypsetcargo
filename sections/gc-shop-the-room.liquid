{%- comment -%}
  Gypset Cargo: shoppable room photo. Add a hotspot block per light, pick its product and drag the
  X/Y sliders until the dot sits on the fitting.
{%- endcomment -%}
<div class="gc-section page-width color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="gc-section__heading h3">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.intro != blank -%}
    <div class="gc-section__intro">{{ section.settings.intro }}</div>
  {%- endif -%}
  <div class="gc-room">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'gc-room__image',
          loading: 'lazy',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'gc-room__image' }}
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      {%- if p != blank -%}
        <details class="gc-hotspot" style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;" {{ block.shopify_attributes }}>
          <summary><span class="visually-hidden">{{ p.title }}</span></summary>
          <a class="gc-hotspot__card" href="{{ p.url }}">
            {%- if p.featured_image -%}
              {{ p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            {%- endif -%}
            <span><strong>{{ p.title }}</strong>{{ p.price | money }}</span>
          </a>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if section.settings.caption != blank -%}
    <p class="gc-tile__caption">{{ section.settings.caption }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Shop the room (GC)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the room" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "image_picker", "id": "image", "label": "Room photo" },
    { "type": "text", "id": "caption", "label": "Photo credit" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "x", "label": "Across (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "y", "label": "Down (%)", "min": 0, "max": 100, "step": 1, "default": 50 }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Shop the room (GC)" }]
}
{% endschema %}
