{%- comment -%}
  Gypset Cargo: shop by room tiles. One block per room, each pointing at a collection
  (e.g. Dining, Living, Bedroom, Bathroom, Entry). Tiles without a collection are hidden on the live site.
{%- endcomment -%}
<div class="gc-section page-width color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="gc-section__heading h3">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <ul class="gc-tiles">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      {%- if c != blank or request.design_mode -%}
        <li {{ block.shopify_attributes }}>
          <a class="gc-tile" href="{{ c.url | default: '#' }}">
            {%- assign gc_img = block.settings.image | default: c.featured_image -%}
            {%- if gc_img != blank -%}
              {{ gc_img | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 750px) 20vw, 50vw', alt: '' }}
            {%- else -%}
              <span class="gc-tile__placeholder"></span>
            {%- endif -%}
            <span>{{ block.settings.label | default: c.title }}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Shop by room (GC)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by room" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Room",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection name" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Shop by room (GC)" }]
}
{% endschema %}
