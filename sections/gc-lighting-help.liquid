{%- comment -%}
  Gypset Cargo: lighting help teaser on the homepage. Image on one side, text and a button on the other.
{%- endcomment -%}
<div class="gc-rd page-width">
  <div class="gc-split">
    <div class="gc-split__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1400' }}
      {%- endif -%}
    </div>
    <div class="gc-split__body">
      {%- if section.settings.eyebrow != blank -%}<p class="gc-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="gc-rd__heading h2">{{ section.settings.heading }}</h2>
      <div>{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a class="gc-pill" href="{{ section.settings.button_link | default: '/pages/contact' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GC lighting help",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lighting help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure what will work?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Send us a photo of your space, your ceiling height and your table size, and we'll suggest the right pieces and how high to hang them.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send us your space" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "GC lighting help" }]
}
{% endschema %}
